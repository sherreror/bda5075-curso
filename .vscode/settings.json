{
  "python.defaultInterpreterPath": "/usr/local/bin/python",
  "jupyter.kernels.excludePythonEnvironments": ["/usr/bin/python3", "/usr/bin/python", "/bin/python3"],
  "jupyter.kernels.filter": [
    { "path": "/usr/bin/python3", "type": "pythonEnvironment" },
    { "path": "/usr/bin/python",  "type": "pythonEnvironment" },
    { "path": "/bin/python3",     "type": "pythonEnvironment" }
  ]
}
